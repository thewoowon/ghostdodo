# ─────────────────────────────────────────────────────────────
# GhostDodo — local development environment
# Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Web (apps/web) ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Server-side only: used by RSC fetches inside docker/CI networks.
API_INTERNAL_BASE_URL=http://localhost:8000/api/v1

# ── API (apps/api) ───────────────────────────────────────────
APP_ENV=development
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://ghostdodo:ghostdodo@localhost:5432/ghostdodo
REDIS_URL=redis://localhost:6379/0

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=change_me_dev_only_do_not_use_in_production_0000
SESSION_COOKIE_NAME=gd_session
SESSION_TTL_SECONDS=1209600
MAGIC_LINK_TTL_SECONDS=900

# ── Object storage (evidence — PRIVATE bucket, never public) ─
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=ghostdodo-evidence-dev
S3_ACCESS_KEY=ghostdodo
S3_SECRET_KEY=ghostdodo_dev_secret
S3_FORCE_PATH_STYLE=true
EVIDENCE_UPLOAD_URL_TTL_SECONDS=600
EVIDENCE_MODERATOR_URL_TTL_SECONDS=300
EVIDENCE_MAX_BYTES=10485760

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=

# ── Email ────────────────────────────────────────────────────
# console = print magic links to stdout (dev only)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@ghostdodo.com

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Google sign-in ───────────────────────────────────────────
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
#
# Register this exact Authorized redirect URI:
#   http://localhost:8000/api/v1/auth/google/callback
#
# Leave these empty and the sign-in page simply does not offer the
# Google button; the email magic link keeps working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed when the callback is not {APP_BASE_URL}/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=

# ── Feature flags ────────────────────────────────────────────
ENABLE_COMMUNITY=false
ENABLE_JOBS=true
ENABLE_COMPANY_PORTAL=false
